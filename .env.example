# LiteLLM configuration template
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# The keys below match the environment variables consumed by
# docker-compose.yml. Leave optional sections blank/commented to skip them.

# --- Core (required) ---
# Master API key; auth key for accessing the proxy.
LITELLM_MASTER_KEY=
# Salt key used to hash stored API keys.
LITELLM_SALT_KEY=

# --- Database (optional) ---
# Used only if you provision/manage models in a database.
# Leave blank to manage models in config.yaml instead.
DATABASE_URL=
SCHEMA_NAME=
STORE_MODEL_IN_DB=

# --- SMTP (optional) ---
# Only needed if you enable email callbacks (e.g. smtp_email in config.yaml).
# Comment out or leave blank to disable email notifications.
# SMTP_HOST=
# SMTP_TLS=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_SENDER_EMAIL=
# SMTP_PASSWORD=

# --- Prometheus Metrics (optional) ---
# Dedicated port for Prometheus metrics scraping (avoids mixing with inference traffic).
# When set, /metrics is served on this port in addition to port 4000.
PROMETHEUS_METRICS_PORT=4001

# --- Note on special characters ---
# Docker Compose interpolates $VAR inside .env values. If a password or
# other value contains a literal $ (e.g. a generated secret), escape it
# as $$ so the literal $ is passed through:  $$pecial  ->  $pecial
